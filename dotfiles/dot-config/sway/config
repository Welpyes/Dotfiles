### Variables
set $mod Mod1
set $alt Mod1
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu rofi -show drun -theme ~/.config/rofi/dmenu.rasi
floating_modifier $mod 

### Output
output HDMI-A-2 mode 1366x768@60Hz bg ~/Documents/wallpapers/kazusa-nice.png fill

### Gaps & Padding
gaps inner 10
gaps outer 0
gaps top 10
gaps bottom 10
gaps left 100
gaps right 100

### Borders
default_floating_border pixel 2
default_border pixel 2
client.focused          #c0caf5 #c0caf5 #171823 #c0caf5 #c0caf5
client.unfocused        #171823 #171823 #5c5c5c #171823 #171823
client.focused_inactive #171823 #171823 #5c5c5c #171823 #171823

####################
#   Applications   #
####################

bindsym $alt+Return       exec $term
bindsym $alt+Shift+Return exec $term

bindsym $alt+space       exec rofi -show drun -theme ~/.config/rofi/dmenu.rasi
bindsym $alt+Tab         exec rofi -show window -theme ~/.config/rofi/dmenu.rasi
bindsym $alt+r           exec rofi -show run   -theme ~/.config/rofi/dmenu.rasi

bindsym $alt+e       exec $term -e yazi
bindsym $alt+Shift+e exec nautilus

bindsym $alt+Shift+s exec grim ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S_scrot.png')

####################
#   Window mgmt    #
####################

bindsym $alt+q kill
bindsym $alt+Shift+r reload
bindsym $alt+Shift+q exec swaymsg exit

bindsym $alt+f           fullscreen
bindsym $alt+s           floating toggle
bindsym $alt+Shift+m     layout toggle tabbed split

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

####################
#    Focus/Move    #
####################

bindsym $alt+h focus left
bindsym $alt+j focus down
bindsym $alt+k focus up
bindsym $alt+l focus right

bindsym $alt+Shift+h move left
bindsym $alt+Shift+j move down
bindsym $alt+Shift+k move up
bindsym $alt+Shift+l move right

bindsym $alt+c       focus next
bindsym $alt+Shift+c focus prev

bindsym $alt+bracketleft  workspace prev
bindsym $alt+bracketright workspace next

####################
#    Workspaces    #
####################

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

####################
#   Move/Resize    #
####################

bindsym ctrl+h resize shrink width 20px
bindsym ctrl+j resize grow   height 20px
bindsym ctrl+k resize shrink height 20px
bindsym ctrl+l resize grow   width 20px

bindsym ctrl+$alt+h resize grow   width 20px
bindsym ctrl+$alt+j resize shrink height 20px
bindsym ctrl+$alt+k resize grow   height 20px
bindsym ctrl+$alt+l resize shrink width 20px

bindsym $mod+Left  move left  20px
bindsym $mod+Down  move down  20px
bindsym $mod+Up    move up    20px
bindsym $mod+Right move right 20px

####################
#    Utilities     #
####################

bindsym --locked XF86AudioMute        exec pactl set-sink-mute   @DEFAULT_SINK@   toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@   -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@   +5%
bindsym --locked XF86AudioMicMute     exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym Print exec grim

exec autotiling-rs

# vim: ft=bash

